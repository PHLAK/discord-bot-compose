APP_NAME="PHLAKNET Discord Bot"
APP_ENV=local
APP_TIMEZONE=UTC
APP_URL=http://localhost

CACHE_STORE=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

### --- OAUTH PROVIDERS --- ###

POCKETID_USE_PKCE=false
POCKETID_BASE_URL=
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=
POCKETID_REDIRECT_URI=

### --- EXTERNAL SERVICES --- ###

DISCORD_WEBHOOK_URL=

### --- WEBHOOKS --- ###

WEBHOOK_KEY=

### --- ERROR REPORTING --- ###

SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0
