# ------------------------------------------------------------------------------
# Version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# IMAGE_VERSION=latest

# ------------------------------------------------------------------------------
# Application server port exposed to the host.
# ------------------------------------------------------------------------------

# APP_PORT=8080

# ------------------------------------------------------------------------------
# Application encryption key. Generate with 'artisan key:generate --show'
# ------------------------------------------------------------------------------

APP_KEY=

# ------------------------------------------------------------------------------
# Database configuration. Only the password is required when using
# the provided 'mysql' container.
# ------------------------------------------------------------------------------

# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=app
# DB_USERNAME=discord-bot
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Host process user and group IDs. Setting these will map the host user/group
# to the user/group running within the container. This helps avoid permission
# issues between your host machine and docker container.
# ------------------------------------------------------------------------------

# HOST_USER_ID=
# HOST_GROUP_ID=
